{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:static": "tsc -b && vite build --mode static && node scripts/copy-snapshot.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "parity": "vitest run --project parity",
    "e2e": "playwright test",
    "preview": "vite preview",
    "size": "node scripts/check-bundle-size.mjs --budget-kb 180"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-compression2": "^2.5.4",
    "vitest": "^5.0.5"
  }
}
